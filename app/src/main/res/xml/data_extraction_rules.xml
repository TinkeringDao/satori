<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+.
    Recordings, transcripts and AI notes never leave this phone: nothing is copied by cloud
    backup or by device-to-device transfer. (allowBackup="false" alone does not stop device
    transfer on Android 12+.) Models are re-imported on a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
