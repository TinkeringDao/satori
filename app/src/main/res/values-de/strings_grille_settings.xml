    <!-- Erweitert: KI-Modell -->
    <string name="g_settings_ai_model">KI-Modell</string>
    <string name="g_settings_ai_model_help">Das hier gewählte Modell schreibt die Notizen während der Aufnahme. Gemma 4 E2B ist nicht wählbar: Es arbeitet nach dem Stoppen, mit dem Schalter darunter.</string>
    <string name="g_settings_ai_model_none">Eines herunterladen, um Notizen zu bekommen.</string>
    <string name="g_settings_ai_model_busy">Es wird immer nur ein Modell heruntergeladen. Zum Starten eines anderen das laufende pausieren.</string>
    <string name="g_settings_model_q8">Standard</string>
    <string name="g_settings_model_q8_desc">Gemma 3 1B. Genauer; braucht mehr Arbeitsspeicher und Akku. Etwa %1$s.</string>
    <string name="g_settings_model_iq4">Effizient</string>
    <string name="g_settings_model_iq4_desc">Gemma 3 1B. Schont Arbeitsspeicher und Akku. Etwa %1$s.</string>
    <string name="g_settings_model_qwen_desc">Ein Modell eines anderen Herstellers, zum Ausprobieren. Seine Notizen können anders ausfallen. Etwa %1$s.</string>
    <string name="g_settings_model_e2b_desc">Schreibt die Notizen nach dem Stoppen, nicht während der Aufnahme. Besser, aber langsamer. Etwa %1$s.</string>
    <string name="g_settings_finishing_model">KI nach der Aufnahme</string>
    <string name="g_settings_finishing_model_desc">Gemma 4 E2B schreibt nach dem Stoppen Notizen, Namen und Aufgaben: besser, aber langsamer. Aus: Das oben gewählte Modell übernimmt. Bei knappem Arbeitsspeicher übernimmt trotzdem dieses Modell, oder die Arbeit wartet, bis eine Aufnahme endet.</string>
    <string name="g_settings_model_experimental">Experimentell</string>
    <string name="g_settings_model_recommended">Für dieses Telefon empfohlen</string>
    <string name="g_settings_model_on_phone">Auf diesem Telefon</string>
