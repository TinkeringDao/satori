    <string name="g_settings_model_delete_last_body">Vorhandene Notizen bleiben. Bis wieder ein Modell da ist, entstehen zu neuen Aufnahmen keine Notizen.</string>

    <!-- Erweitert: Notizen und Übersetzung, für jede Art von Aufnahme -->
    <string name="g_settings_notes_help">Wie und wann die KI Notizen schreibt, für jede Art von Aufnahme.</string>
    <string name="g_settings_interval">Notizen alle</string>
    <string name="g_settings_interval_desc">Öfter: Die Notizen folgen dem Gesagten schneller, brauchen aber mehr Akku.</string>
    <string name="g_settings_interval_translate">Übersetzen alle</string>
    <string name="g_settings_interval_translate_desc">Öfter: Die Übersetzung folgt schneller, braucht aber mehr Akku.</string>
    <string name="g_settings_strategy">Wann Notizen entstehen</string>
    <string name="g_settings_strategy_desc">Während der Aufnahme: Notizen erscheinen beim Sprechen. Nach der Aufnahme: Notizen entstehen erst nach dem Stoppen, und das Telefon hat beim Aufnehmen weniger zu tun.</string>
    <string name="g_settings_strategy_translate">Wann übersetzt wird</string>
    <string name="g_settings_strategy_translate_desc">Während der Aufnahme: Übersetzung beim Sprechen. Nach der Aufnahme: alles nach dem Stoppen, und das Telefon hat beim Aufnehmen weniger zu tun.</string>
