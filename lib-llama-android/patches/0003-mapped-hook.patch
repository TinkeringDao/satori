+#include <mutex>
+
+// Satori (lib-llama-android/patches/0003-mapped-hook.patch): the byte ranges, per file, of the
+// tensors the load under way copied out of its mapping (repacked into another buffer type) and of
+// those it uses in place, as first and end offsets, for the hook ai_chat.cpp sets: once the copy is
+// done it gives the copied ones' pages back, while all of the mapping is still mapped.
+static std::mutex                       g_satori_mapped_mutex;
+static llama_satori_mapped_hook         g_satori_mapped_hook = nullptr;
+static void *                           g_satori_mapped_user = nullptr;
+static std::vector<std::vector<size_t>> g_satori_copied;
+static std::vector<std::vector<size_t>> g_satori_in_place;
+
+void llama_satori_set_mapped_hook(llama_satori_mapped_hook hook, void * user_data) {
+    std::lock_guard<std::mutex> lock(g_satori_mapped_mutex);
+    g_satori_mapped_hook = hook;
+    g_satori_mapped_user = user_data;
+}
+
+static void satori_note_tensor(uint16_t idx, size_t offs, size_t n_size, bool in_place) {
+    std::lock_guard<std::mutex> lock(g_satori_mapped_mutex);
+    auto & ranges = in_place ? g_satori_in_place : g_satori_copied;
+    if (idx >= ranges.size()) {
+        ranges.resize(idx + 1);
+    }
+    ranges[idx].push_back(offs);
+    ranges[idx].push_back(offs + n_size);
+}
